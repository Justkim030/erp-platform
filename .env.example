POSTGRES_PASSWORD=change-me
# Generate with: npm run gen-key -w @platform/identity   (paste the JSON on one line)
SIGNING_KEY_JWK=
# Long random string. Only the platform owner knows it; it unlocks the hidden platform endpoints.
PLATFORM_BOOTSTRAP_TOKEN=
# Optional: comma-separated IPs/CIDRs allowed to call the platform endpoints (recommended in production)
PLATFORM_ALLOWED_IPS=
# WebAuthn relying party settings. Use the portal host and its exact HTTPS origin in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ERP Platform
WEBAUTHN_ORIGINS=http://localhost:3000
DEFAULT_ORG=            # your organisation slug (shown on the sign-in page; the seed script uses ORG_SLUG)
# Development only: DEV_SEED_ORG=1 makes `npm run dev:identity` create an organisation
# and print a one-time activation code. Never set this in production.
COOKIE_SECURE=false
CSP_MODE=report-only
# Proxies between the internet and the services: 1 = portal only, 2 = reverse proxy + portal
TRUST_PROXY=1
RETENTION_DAYS=90
# Optional production tile provider. The URL supports {z}, {x}, {y}, and {apiKey}.
# Browser-visible keys must be restricted to the portal's allowed domains.
MAP_TILE_URL=
MAP_TILE_API_KEY=
MAP_TILE_ATTRIBUTION=
